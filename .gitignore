# Dependency directories
node_modules/
**/node_modules/

# Build artifacts
dist/
**/dist/
build/
**/build/
out/
**/out/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
*.swp

# IDEs
.vscode/
.idea/

# Testing
coverage/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bun
.bun-build/

# Local storage created at runtime (LocalStorageAdapter defaults to ./storage)
storage/
# ...but never source directories that happen to be named `storage`
# (e.g. packages/web-kit/src/features/storage, the SDK storage clients).
!**/src/**/storage/
!sdks/**/storage/

# Local databases
*.db
*.sqlite
*.sqlite3

# Claude Code local state (agent memory, checklists, session config)
.claude/

# Secret-scan reports
gitleaks-report.json
