        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@iskra-bun/core": "workspace:*",
        "@aws-sdk/client-sesv2": "^3.600.0",
        "@sendgrid/mail": "^8.1.0",
        "nodemailer": "^6.9.1"
    },
    "devDependencies": {
        "@types/bun": "^1.3.5",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^7.0.4"
    }
}
