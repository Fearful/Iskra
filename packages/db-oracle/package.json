{
    "name": "@iskra-bun/db-oracle",
    "version": "0.3.0",
    "description": "Oracle Database en Iskra: pool de oracledb (modo Thin) en el proceso, Kysely, paginación y migraciones.",
    "keywords": [
        "iskra",
        "bun",
        "typescript",
        "oracle",
        "database",
        "sql",
        "kysely",
        "experimental"
    ],
    "author": "Joan Lascano",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/db-oracle"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/db-oracle#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "engines": {
        "bun": ">=1.3.0"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "bun": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./testing": {
            "source": "./src/testing.ts",
            "bun": "./src/testing.ts",
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.js",
            "default": "./dist/testing.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.0",
        "@iskra-bun/core": "workspace:^",
        "kysely": "^0.29.6",
        "oracledb": "^6.10.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/oracledb": "^6.10.2",
        "bun-types": "latest"
    }
}
