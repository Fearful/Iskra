{
    "name": "@iskra-bun/mobile-kit",
    "version": "0.1.1",
    "description": "Experimental placeholder for mobile apps in Iskra: registers a driver in the App lifecycle but does not integrate with any mobile platform yet.",
    "keywords": [
        "iskra",
        "bun",
        "typescript",
        "mobile",
        "tauri",
        "experimental"
    ],
    "author": "Joan Lascano",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/mobile-kit"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/mobile-kit#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "engines": {
        "bun": ">=1.3.0"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "bun": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@iskra-bun/core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.6.2"
    }
}
