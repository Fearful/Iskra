{
    "name": "@iskra-bun/web-kit",
    "version": "0.2.0",
    "description": "Servidor HTTP de Iskra basado en Hono, con Kernel y features (auth, cors, db, health, etc.).",
    "keywords": [
        "iskra",
        "bun",
        "typescript",
        "hono",
        "http",
        "web",
        "server"
    ],
    "author": "Joan Lascano",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/web-kit"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/web-kit#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "engines": {
        "bun": ">=1.3.0"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "bun": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@hono/zod-openapi": "^1.6.3",
        "@hono/zod-validator": "^0.9.1",
        "@iskra-bun/core": "workspace:*",
        "@iskra-bun/auth-kit": "workspace:*",
        "@iskra-bun/mailer-kit": "workspace:*",
        "@iskra-bun/storage-kit": "workspace:*",
        "better-auth": "^1.6.33",
        "drizzle-orm": "^0.45.3",
        "hono": "^4.12.34",
        "ioredis": "^5.8.2",
        "mysql2": "^3.24.4",
        "postgres": "^3.4.7",
        "ajv": "^8.20.0",
        "ajv-errors": "^3.0.0",
        "ajv-formats": "^3.0.1",
        "zod": "^3.24.1",
        "@hono/otel": "^1.0.0",
        "@opentelemetry/api": "^1.9.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^7.0.4"
    }
}
