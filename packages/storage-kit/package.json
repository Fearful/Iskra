        "directory": "packages/storage-kit"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/storage-kit#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "type": "module",
    "main": "./dist/index.js",
