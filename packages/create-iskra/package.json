            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "templates",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ./tsup.config.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.3.5",
        "@types/node": "^22.10.2"
    }
