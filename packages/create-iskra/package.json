{
    "name": "create-iskra",
    "version": "0.1.0",
    "description": "Andamiaje de proyectos Iskra (CLI).",
    "keywords": [
        "iskra",
        "bun",
        "cli",
        "scaffold",
        "create"
    ],
    "author": "Joan Lascano",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/create-iskra"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/create-iskra#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "engines": {
        "node": ">=18"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "create-iskra": "./dist/cli.js"
    },
    "exports": {
