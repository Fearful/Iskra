        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/config-kit"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/config-kit#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "type": "module",
    "main": "./dist/index.js",
