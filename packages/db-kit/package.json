    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@iskra-bun/core": "workspace:*",
        "drizzle-orm": "^0.30.0",
        "postgres": "^3.4.4",
        "mysql2": "^3.9.2",
        "@libsql/client": "^0.6.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "drizzle-kit": "^0.30.0"
    }
}
