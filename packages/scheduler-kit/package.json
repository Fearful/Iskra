{
    "name": "@iskra-bun/scheduler-kit",
    "version": "0.0.0",
    "description": "Periodic jobs in the app's own process for Iskra, without Redis, with the API of worker-kit's WorkerManager.",
    "keywords": [
        "iskra",
        "bun",
        "typescript",
        "scheduler",
        "interval",
        "jobs"
    ],
    "author": "Joan Lascano",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fearful/iskra.git",
        "directory": "packages/scheduler-kit"
    },
    "homepage": "https://github.com/fearful/iskra/tree/main/packages/scheduler-kit#readme",
    "bugs": "https://github.com/fearful/iskra/issues",
    "engines": {
        "bun": ">=1.3.0"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "bun": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "bun test",
        "build": "tsup --config ../../tsup.config.ts"
    },
    "dependencies": {
        "@iskra-bun/core": "workspace:^"
    },
    "devDependencies": {
        "@iskra-bun/worker-kit": "workspace:^",
        "@types/bun": "^1.3.5",
        "@types/node": "^22.10.2"
    }
}
