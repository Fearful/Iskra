# ─── Iskra Framework — Dockerfile Base (Multi-stage) ─────────────────────────
# Uso: docker build -f templates/<nombre>/Dockerfile .
#
# ARGs requeridos:
#   TEMPLATE_NAME  — nombre del template (ej: ecommerce-api)
#   ENTRY_POINT    — archivo de entrada (ej: src/main.ts)

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1 AS builder

ARG TEMPLATE_NAME
ARG ENTRY_POINT=src/main.ts

WORKDIR /build

# Copiar archivos de configuración del monorepo
COPY package.json bun.lock* tsconfig.base.json ./

# Copiar los packages y el template target
COPY packages/ packages/
COPY templates/${TEMPLATE_NAME}/ templates/${TEMPLATE_NAME}/

# Instalar dependencias
RUN bun install --frozen-lockfile --production

# Compilar a binario standalone
RUN bun build \
    templates/${TEMPLATE_NAME}/${ENTRY_POINT} \
    --compile \
    --target=bun-linux-x64 \
    --outfile=/build/app

# ─── Stage 2: Runtime (UBI9 Minimal) ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS runtime

# Instalar libstdc++ (requerido por el binario compilado de Bun)
RUN microdnf install -y libstdc++ && \
    microdnf clean all

# Crear usuario no-root
RUN microdnf install -y shadow-utils && \
    useradd -u 1001 -r -g 0 -s /sbin/nologin iskra && \
    microdnf remove -y shadow-utils && \
    microdnf clean all

WORKDIR /app

# Copiar el binario compilado
COPY --from=builder --chown=1001:0 /build/app /app/app

# Ejecutar como usuario no-root
USER 1001

ENTRYPOINT ["/app/app"]
