# ─── Iskra Framework — Dockerfile Base (Multi-stage) ─────────────────────────
# Reference for a new template's Dockerfile. Build from the repository root:
#   docker build -f Dockerfile.base \
#     --build-arg TEMPLATE_NAME=ecommerce-api --build-arg ENTRY_POINT=src/main.ts .
#
# ARGs:
#   TEMPLATE_NAME  — template directory under templates/ (e.g. ecommerce-api)
#   ENTRY_POINT    — entry file inside it (default: src/main.ts)

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
# The Bun the monorepo is pinned to (.bun-version).
FROM oven/bun:1.4.2 AS builder

ARG TEMPLATE_NAME
ARG ENTRY_POINT=src/main.ts

WORKDIR /build

# The whole workspace, filtered by the root .dockerignore: the lockfile covers
# every workspace, so copying only some of them fails --frozen-lockfile.
COPY . .
RUN bun install --frozen-lockfile

# bun build inlines process.env.NODE_ENV ("development" unless set here), so
# the runtime environment cannot change it: without this the binary runs in
# development mode (stack traces in error responses, non-Secure session
# cookies, pretty logs).
ENV NODE_ENV=production

RUN bun build templates/${TEMPLATE_NAME}/${ENTRY_POINT} --compile --outfile=/build/app

# ─── Stage 2: Runtime (UBI9 Minimal) ─────────────────────────────────────────
# The compiled binary needs only glibc, which ubi-minimal ships: no package
# installs, so this stage also builds offline or behind a TLS-inspecting proxy.
# A minor release, not `latest`: security rebuilds of 9.8 still arrive, a new
# minor comes through a Dependabot PR.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

WORKDIR /app
# Owned by root: the runtime user can run the binary but not replace it, so
# code execution in the app cannot persist by overwriting it.
COPY --from=builder /build/app /app/app

ENV NODE_ENV=production

# Non-root, arbitrary UID in group 0 (OpenShift convention).
USER 1001:0

ENTRYPOINT ["/app/app"]
