# Job Worker — Variables de entorno

# Entorno: development para correrlo en local. Sin NODE_ENV (o con cualquier otro
# valor) rigen los defaults de produccion, como en la imagen Docker (DEMO apagado).
NODE_ENV=development

# ─── Worker ──────────────────────────────────────────────────────────────────
CONCURRENCY=2
QUEUE_NAME=iskra-jobs

# ─── Retry / Backoff ─────────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
BACKOFF_TYPE=exponential        # fixed | exponential
BACKOFF_DELAY=1000              # ms (base del backoff)

# ─── Dead-letter queue ───────────────────────────────────────────────────────
DLQ_NAME=iskra-jobs-dlq
DLQ_KEEP=1000                   # dead letters que se conservan en Redis (los mas nuevos)

# ─── HTTP (health / monitoring) ──────────────────────────────────────────────
HTTP_PORT=8080

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Demo ────────────────────────────────────────────────────────────────────
# Encolar jobs de ejemplo. Sin DEMO: si fuera de produccion, no con NODE_ENV=production.
DEMO=true
