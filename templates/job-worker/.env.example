# Job Worker — Variables de entorno

# ─── Worker ──────────────────────────────────────────────────────────────────
CONCURRENCY=2
QUEUE_NAME=iskra-jobs

# ─── Retry / Backoff ─────────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
BACKOFF_TYPE=exponential        # fixed | exponential
BACKOFF_DELAY=1000              # ms (base del backoff)

# ─── Dead-letter queue ───────────────────────────────────────────────────────
DLQ_NAME=iskra-jobs-dlq

# ─── HTTP (health / monitoring) ──────────────────────────────────────────────
HTTP_PORT=8080

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Demo ────────────────────────────────────────────────────────────────────
DEMO=true                       # false para no encolar jobs de ejemplo
