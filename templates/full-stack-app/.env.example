PORT=3000
SOCKET_PORT=3001
DATABASE_URL=:memory:

# Oracle (opcional — requiere sidecar bridge). Conectate con un usuario propio
# de la app que tenga solo los permisos que usa (CREATE SESSION y los de sus
# tablas), nunca con SYSTEM/SYS: una inyeccion SQL o una credencial filtrada
# tendrian toda la base.
# Sin ORA_CONN el OracleDriver no arranca (lo avisa en el log). El puente corre
# con Node (`node` en el PATH) y necesita `bun add oracledb`.
# ORA_CONN=localhost:1521/XEPDB1
# ORA_USER=app_user
# ORA_PASSWORD=<password larga y aleatoria>
