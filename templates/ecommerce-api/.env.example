# Ecommerce API — Variables de entorno
PORT=3000
DATABASE_URL=ecommerce.db

# Usuarios de la API: <userId>:<rol>:<clave>, separados por comas.
# Roles: admin (productos y todas las ordenes) o customer (sus ordenes).
# Claves de al menos 32 caracteres: openssl rand -hex 32
# Vacio: el catalogo es publico y todo lo demas responde 401.
API_KEYS=
