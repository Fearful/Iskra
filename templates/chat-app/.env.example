# Entorno: development para correrlo en local. Sin NODE_ENV (o con cualquier otro
# valor) rigen los defaults de produccion, como en la imagen Docker.
NODE_ENV=development

# Puerto del servidor WebSocket
SOCKET_PORT=3001

# Secreto del servidor para firmar y verificar los tokens de chat. Solo lo
# conocen el servidor y `bun run token`: los clientes reciben tokens, nunca el
# secreto. En produccion es obligatorio y de al menos 32 caracteres:
#   openssl rand -base64 48
# Vacio: fuera de produccion se usa uno de ejemplo, con un aviso.
CHAT_AUTH_SECRET=

# Adaptador del KV store: "memory" (default) o "redis".
KV_DRIVER=memory
