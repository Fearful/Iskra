{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "customConditions": null,
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "target": "ES2020",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
