# Copy to .env next to docker-compose.yml and fill in every secret: there are
# no defaults, and in production (the Docker images) the services refuse to
# start without them. Generate each one with:
#
#   openssl rand -base64 32
#
# except the two passwords, which go into connection URLs where the "/" and "+"
# of base64 break them: use `openssl rand -hex 32` for those.

# PostgreSQL
DB_PASSWORD=

# Redis (requirepass)
REDIS_PASSWORD=

# Admin API sessions (Better Auth), at least 32 characters
AUTH_SECRET=

# admin-api and cron send it to form-manager's /internal API, which requires
# it; at least 32 characters
INTERNAL_API_TOKEN=

# forms-api: CSRF token signatures and the key of the daily IP hash, at least
# 32 characters each, and different
CSRF_SECRET=
IP_HASH_SECRET=

# reCAPTCHA v3 keys, from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Hostnames the form pages are served from, comma-separated (e.g.
# forms.example.com): forms-api refuses tokens issued on other sites. Empty
# accepts any hostname; set it in production.
RECAPTCHA_HOSTNAMES=
